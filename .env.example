# ============================================================
# .env — credenciais do publicador (NÃO versionar, NÃO compartilhar por canal inseguro)
# Copie este arquivo para ".env" e preencha com SEU login do Payload.
# O script lê este arquivo sozinho (não precisa de python-dotenv).
# ============================================================

# --- OBRIGATÓRIO (publicação no Payload) ---
PAYLOAD_API_URL=https://metakosmos.com.br
PAYLOAD_EMAIL=seu-email@metakosmos.com.br
PAYLOAD_PASSWORD=sua-senha-do-painel-payload

# --- OPCIONAL ---
# PAYLOAD_API_KEY=            # alternativa ao email/senha (se o time gerar API key)
# PAYLOAD_AUTH_COLLECTION=users
# PAYLOAD_AUTH_SCHEME=JWT

# --- LEGADO WordPress (NÃO é usado pela publicação Payload; pode ignorar) ---
# WP_SITE_URL=
# WP_USERNAME=
# WP_PASSWORD=
